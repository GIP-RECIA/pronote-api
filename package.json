{
  "name": "pronote-api",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "dotenv-checker && vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint src/main/webapp/src/",
    "postinstall": "husky",
    "changelog:generate": "commit-and-tag-version --packageFiles pom.xml --skip.bump --skip.tag --skip.commit -t ''"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@gip-recia/ui": "^1.0.5",
    "@gip-recia/ui-webcomponents": "^1.18.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24",
    "@types/xml2js": "^0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "commit-and-tag-version": "^13.1.2",
    "dotenv": "^17.4.2",
    "dotenv-checker": "^1.1.7",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.104.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
