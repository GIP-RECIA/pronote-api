{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/main/webapp/src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "env.d.ts",
    "src/main/webapp/src/**/*",
    "src/main/webapp/src/**/*.vue"
  ],
  "exclude": ["src/main/webapp/src/**/__tests__/*"]
}